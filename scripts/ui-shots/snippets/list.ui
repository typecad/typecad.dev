<script>
  import { ui } from '@typecad/ui';
  ui.mount(screen);

  export const picked = ui.signal(-1);
  ui.bindList(
    screen.log,
    () => 40,
    (i: number) => `Entry ${i + 1}`,
    (i: number) => { picked.set(i); },
  );
</script>

<style>
  screen { padding: 8px; }
  #log { border: 1px solid #d4d4d8; }
</style>

<screen id="lists">
  <list id="log" item-height="22"></list>
</screen>
